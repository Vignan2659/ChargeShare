# Copy this file to .env and fill in the values.  Lines starting with # are ignored.

ENVIRONMENT=development
DATABASE_URL=sqlite:///./chargeshare.db
# Production: the Postgres URL from Supabase (Project settings → Database → Connection string → URI)
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Any long random string. Generate one with:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# The address phones use to reach this server.
# On your Wi-Fi during development: http://<your-mac-ip>:8000   (find it: System Settings → Wi-Fi → Details)
# In production: https://chargeshare-api.onrender.com
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=*

# Phone numbers that become admins when they log in
ADMIN_PHONES=+919000000001

COMMISSION_PERCENT=10

# --- OTP SMS ---  console = code printed in this terminal (development)
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Give these to Apple / Google reviewers so they can log in without a real SMS
DEMO_PHONE=+919999999999
DEMO_OTP=246810

# --- Payments ---  mock = no real money (a "Pay (test)" button appears in the app)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- File storage ---  local = saved in ./uploads
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_PUBLIC_BUCKET=public-media
SUPABASE_PRIVATE_BUCKET=private-docs

# --- Push notifications (optional: Expo access token for extra security) ---
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=
