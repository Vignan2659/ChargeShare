# Copy to .env  (Expo loads it automatically)

# Address of the FastAPI server.
# Phone on the same Wi-Fi as your Mac: http://<your-mac-ip>:8000   e.g. http://192.168.1.20:8000
# Production: https://chargeshare-api.onrender.com
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000

# Links shown in the app (served by the backend)
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com

# Google Maps key for Android (Google Cloud Console → Maps SDK for Android). iPhone uses Apple Maps, no key needed.
GOOGLE_MAPS_ANDROID_KEY=

# Filled after you run `npx eas init`
EAS_PROJECT_ID=

APP_NAME=ChargeShare
# Must be unique on the stores and can never change after the first release, e.g. com.yourname.chargeshare
APP_BUNDLE_ID=com.chargeshare.app
